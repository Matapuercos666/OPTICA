
* {
    background-color: %1;
    color: %2;
}

QPushButton {
    font: bold 10pt 'Arial Black';
    background-color: %3;
    color: %4;
    border: none;
    border-radius: 4px;
    padding: 5px;
}

QPushButton:hover {
    background-color: %15;
}

QPushButton:pressed {
    background-color: %13;
    color: %5;
}

QPushButton#CANCELAR,
QPushButton#CERRAR,
QPushButton#ELIMINAR {
    background-color: %12;
    color: %4;
    border: none;
    border-radius: 4px;
    padding:5px;
}

QPushButton#CANCELAR:hover,
QPushButton#CERRAR:hover,
QPushButton#ELIMINAR:hover {
    background-color: #d32f2f;
}

QPushButton#CANCELAR:pressed,
QPushButton#CERRAR:pressed,
QPushButton#ELIMINAR:pressed {
    background-color: #b71c1c;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: %6;
    color: %7;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
}

#LOGIN QLineEdit {
    min-height: 30px;
    padding-top: 5px;
    padding-bottom: 5px;
}

/*Selectores Info_paciente, Agregar_Paciente, Agregar_consulta*/

QLabel#Nombre,
QLabel#ApellidoP,
QLabel#ApellidoM,
QLabel#Nacimiento,
QLabel#Edad,
QLabel#Sexo,
QLabel#Telefono,
QLabel#Email,
QLabel#Observaciones_2,
QLabel#Antecedentes,
QLabel#AntecedentesO {
    color: %8;
    font-family: 'Roboto Condensed';
    font-size: 12px;
    font-weight: bold;
}

QLabel#OD,
QLabel#OI,
QLabel#OD_2,
QLabel#OI_2,
QLabel#OD_3,
QLabel#OI_3,
QLabel#OD_4,
QLabel#OI_4,
QLabel#OD_5,
QLabel#OI_5,
QLabel#OD_6,
QLabel#OI_6,
QLabel#OD_7,
QLabel#OI_7 {
    color: %11;
    font-family: 'Roboto Condensed';
    font-size: 11px;
}

/*Estilos Info_paciente*/

#Info_paciente QLineEdit[readOnly="false"],
#Info_paciente QTextEdit[readOnly="false"],
#Info_paciente QPlainTextEdit[readOnly="false"] {
    background-color: %9;
    color: %14;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: %3;
    selection-color: %4;
}

#Info_paciente QLineEdit[readOnly="true"],
#Info_paciente QTextEdit[readOnly="true"],
#Info_paciente QPlainTextEdit[readOnly="true"] {
    background-color: transparent;
    color: %2;
    border: none;
    padding: 0px;
    font: inherit;
}

#Info_paciente QLineEdit:focus[readOnly="false"],
#Info_paciente QTextEdit:focus[readOnly="false"],
#Info_paciente QPlainTextEdit:focus[readOnly="false"] {
    background-color: #fcfcfc;
    border: 1px solid %1;
    outline: none;
}

#Info_paciente QLineEdit::placeholder,
#Info_paciente QTextEdit::placeholder {
    color: #9ca3af;
}




/*QTableWidget, QTableView {
    background-color: %9;
    color: %10;
    border: 1px solid %11;
}*/


#Historico_consulta {
    background-color: %9;
    alternate-background-color: #f9fafb;
    gridline-color: #e5e7eb;
    selection-background-color: %3;
    selection-color: %4;
    border: none;
    border-radius: 8px;
}

#Historico_consulta QHeaderView::section{
    background-color: %6;
    color: %2;
    padding: 10px;
    border-bottom: 1px solid %11;
    font-weight: bold;
    border: none;
    font-size: 10pt;
}

#Historico_consulta::item:hover {
    background-color: rgba(69,123,157,0.1);
}


QLabel#Titulo {
    color: %15;
    font-weight: bold;
}

QLabel#Titulo2 {
    color: %13;
    font-family: 'Roboto Condensed';
    font-size: 30px;
    font-weight: bold;
}

QLabel#Titulo3 {
    color: %13;
    font-family: 'Roboto Condensed';
    font-size: 16px;
    font-weight: bold;
}

QLabel#Titulo4,
QLabel#Titulo4_2,
QLabel#Titulo4_3,
QLabel#Titulo4_4,
QLabel#Titulo4_5,
QLabel#Titulo4_6,
QLabel#Titulo4_7,
QLabel#Titulo4_8
{
    color: %11;
    font-family: 'Montserrat';
    font-size: 12px;
    font-weight: bold;
}


QLabel#Titulo5,
QLabel#Titulo5_2,
QLabel#Titulo5_3,
QLabel#Titulo5_4,
QLabel#Titulo5_5,
QLabel#Titulo5_6 {
    font: bold 12pt 'Arial Black';
    color: %2;
}

QLabel#UsuarioActual,
QLabel#IdConsulta {
    font-family: Montserrat;
    color: %2;
    font-size: 9pt;
}

/*Estilos Agregar_Paciente*/

#Agregar_Paciente QLineEdit,
#Agregar_Paciente QTextEdit,
#Agregar_Paciente QPlainTextEdit {
    background-color: %6;
    color: %2;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: %3;
    selection-color: %4;
}

#Agregar_Paciente QLineEdit:focus,
#Agregar_Paciente QTextEdit:focus,
#Agregar_Paciente QPlainTextEdit:focus {
    background-color: #fcfcfc;
    border: 1px solid %1;
    outline: none;
}

#Agregar_Paciente QLineEdit:hover,
#Agregar_Paciente QTextEdit:hover,
#Agregar_Paciente QPlainTextEdit:hover {
    border: 1px solid %13;
}

#Agregar_Paciente QLineEdit::placeholder,
#Agregar_Paciente QTextEdit::placeholder {
    color: #9ca3af;
}

/*Estilos Llenar_Consulta*/

#Llenar_Consulta QLineEdit,
#Llenar_Consulta QTextEdit,
#Llenar_Consulta QPlainTextEdit {
    background-color: %6;
    color: %2;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: %15;
    selection-color: %4;
}

#Llenar_Consulta QLineEdit:focus,
#Llenar_Consulta QTextEdit:focus,
#Llenar_Consulta QPlainTextEdit:focus {
    background-color: #d4edee;
    border: 1px solid %1;
    outline: none;
}

#Llenar_Consulta QLineEdit:hover,
#Llenar_Consulta QTextEdit:hover,
#Llenar_Consulta QPlainTextEdit:hover {
    border: 1px solid %11;
}

#Llenar_Consulta QLineEdit::placeholder,
#Llenar_Consulta QTextEdit::placeholder {
    color: #9ca3af;
}



/* Estilo QDateEdit*/

QDateEdit {
    background-color: %4;
    color: %2;
    border: 1px solid %1;
    border-radius: 5px;
    padding: 2px 4px;
    selection-background-color: %3;
}

QDateEdit:focus {
    border: 1px solid %13;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 15px;
    border-left: 1px solid %11;
}

QDateEdit::down-arrow {
    width: 10px;
    height: 10px;
}

/*ESTILOS QTABLEWIDGET*/

QTableWidget#Datos_Clientes {
    background-color: %9;                /* fondo blanco */
    alternate-background-color: %6;      /* filas alternas azul claro */
    gridline-color: %11;                 /* líneas de grilla negras suaves */
    selection-background-color: %3;      /* selección azul fuerte */
    selection-color: %4;                 /* texto selección blanco */
    border: none;
    border-radius: 6px;
    aligment
}

QTableWidget#Datos_Clientes QHeaderView::section:horizontal {
    background-color: %3;                /* cabecera azul fuerte */
    color: %4;                           /* texto blanco */
    padding: 8px;
    border: none;
    border-right: 1px solid %5;
    font-weight: bold;
    font-size: 10pt;
}

QTableWidget#Datos_Clientes::item:hover {
    background-color: rgba(69, 123, 157, 0.2); /* hover sutil (azul medio transparente) */
}


QTableWidget#Inventario2 {
    background-color: #ffffff;
    alternate-background-color: #e8f5e9;    /* verde muy claro */
    gridline-color: #c8e6c9;
    selection-background-color: #2e7d32;    /* verde oscuro */
    selection-color: white;
    border: 1px solid #a5d6a7;
    border-radius: 6px;
}

QTableWidget#Inventario2 QHeaderView::section:horizontal {
    background-color: #388e3c;              /* verde medio */
    color: white;
    padding: 8px;
    border: none;
    border-right: 1px solid #4caf50;
    font-weight: bold;
    font-size: 10pt;
}

QTableWidget#Inventario2::item:hover {
    background-color: #c8e6c9;
}

QTableWidget#Datos_Empleados {
    background-color: %9;
    alternate-background-color: %1;         /* gris claro */
    gridline-color: %11;
    selection-background-color: %15;        /* azul medio */
    selection-color: %4;
    border: none;
    border-radius: 6px;
}

QTableWidget#Datos_Empleados QHeaderView::section:horizontal {
    background-color: %15;                  /* azul medio */
    color: %4;
    padding: 8px;
    border: none;
    border-right: 1px solid %5;
    font-weight: bold;
    font-size: 10pt;
}

QTableWidget#Datos_Empleados::item:hover {
    background-color: rgba(168, 218, 220, 0.3); /* azul claro transparente */
}


QToolButton {
    background-color: %3;           /* azul fuerte */
    color: %4;                      /* blanco */
    border: none;
    border-radius: 4px;
    min-width: 20px;
    min-height: 8px;
    padding: 5px 10px;
    font-weight: bold;
    font-size: 9pt;
}

QToolButton:hover {
    background-color: %15;          /* azul medio */
}

QToolButton:pressed {
    background-color: %1;           /* gris */
    padding: 6px 10px 4px 10px;    /* efecto de presión */
}


QToolButton#Regresar {
    background-color: %12;          /* rojo, para diferenciar */
}
QToolButton#Regresar:hover {
    background-color: #c62828;
}
QToolButton#MENOS {
    background-color: %12;
}
QToolButton#MAS {
    background-color: %6;
}

QToolButton#LOGO {
    border: none;
    background-color: transparent;
}


QCheckBox {
    spacing: 8px;
    font-family: 'Roboto Condensed';
    font-size: 10pt;
    color: %2;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid %11;
    background-color: %9;
}

QCheckBox::indicator:checked {
    background-color: %3;
    border-color: %3;
}

QCheckBox::indicator:hover {
    border: 1px solid %15;
}

QMessageBox {
    font-family: Montserrat;
    font-size: 10pt;
    color: %3;
}


/* Scrollbar vertical */

QScrollArea {
    border: none;
    background: transparent;
}

QAbstractScrollArea::verticalScrollBar {
    background: transparent;
    width: 0px;
    margin: 0px;
}

QAbstractScrollArea::verticalScrollBar:hover {
    width: 8px;
    background: rgba(0,0,0,0.05);
    border-radius: 4px;
}

QAbstractScrollArea::verticalScrollBar::handle {
    background: rgba(0,0,0,0.3);
    border-radius: 4px;
    min-height: 30px;
}

QAbstractScrollArea::verticalScrollBar::handle:hover {
    background: rgba(0,0,0,0.5);
}


QAbstractScrollArea::verticalScrollBar::add-line,
QAbstractScrollArea::verticalScrollBar::sub-line {
    height: 0px;
}

/* Scrollbar horizontal */

QAbstractScrollArea::horizontalScrollBar {
    background: transparent;
    height: 0px;
}

QAbstractScrollArea::horizontalScrollBar:hover {
    height: 6px;
    background: rgba(0,0,0,0.05);
    border-radius: 3px;
}

QAbstractScrollArea::horizontalScrollBar::handle {
    background: rgba(0,0,0,0.3);
    border-radius: 3px;
    min-width: 30px;
}

QAbstractScrollArea::horizontalScrollBar::handle:hover {
    background: rgba(0,0,0,0.5);
}

QAbstractScrollArea::horizontalScrollBar::add-line,
QAbstractScrollArea::horizontalScrollBar::sub-line {
    width: 0px;
}
